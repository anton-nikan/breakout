#include <array>
#include <string_view>
#include "settings.h"

levels: namespace = {
	BrickType: @enum<char> type = {
		Empty := '0';
		Single := '1';
		Double := '2';
		Solid := '3';

		from_value: (ch) -> _ = {
			return BrickType(ch);
		}
	}

	GridDataType: type == std::array<BrickType, settings::GridWidth * settings::GridHeight>;

	make_grid: (s: std::string_view) -> GridDataType == {
		r:GridDataType = ( BrickType::Empty );

		i := 0;
		for s
		next i++
		do (ch) {
			r[i] = BrickType::from_value(ch);
		}

		return r;
	}

	GridData: const std::array<GridDataType, 1> = (
		(make_grid(
			"1111111111111"
			"1111111111111"
			"1111111111111"
			"1111111111111"
			"0000000000000"
			"0000000000000"
			"0000000000000"
			"0000000000000"
			"0000000000000"
		))
	);
}
